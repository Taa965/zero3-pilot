# Install as /etc/zero3-memory/authority.env with mode 0600.
# Never commit the real file or real bearer/database credentials.

ZERO3_MEMORY_DATABASE_URL='postgresql://zero3_memory_app:REPLACE_DB_PASSWORD@127.0.0.1:5432/zero3_memory'

# One JSON array of bearer grants. Use random tokens >= 24 characters.
# Recommended grants:
# - Pilot/Codex/Claude token: project-scoped, max_authority 60
# - Web GPT GitHub relay token: agent_types ["gpt_web"], max_authority 60,
#   no personal/global access
# - User-approval boundary token: separate process only, agent_types ["system"],
#   max_authority 100; never give this token to an LLM worker
ZERO3_MEMORY_AUTH_JSON='[{"token":"REPLACE_RANDOM_PILOT_TOKEN_32_PLUS_CHARS","client_id":"pilot-main","projects":["*"],"agent_types":["zero3","codex","claude","antigravity"],"max_authority":60,"allow_global":false,"allow_personal":false},{"token":"REPLACE_RANDOM_WEB_GPT_TOKEN_32_PLUS_CHARS","client_id":"github-web-gpt-ingress","projects":["*"],"agent_types":["gpt_web"],"max_authority":60,"allow_global":false,"allow_personal":false}]'

RUST_LOG='zero3_memory_server=info,tower_http=warn'
