# Include this inside an existing HTTPS server block when Memory Authority
# shares a host/IP with another Zero3 service. The trailing slash on proxy_pass
# deliberately strips /memory-authority/ before forwarding to the Rust API.
location ^~ /memory-authority/ {
    client_max_body_size 512k;
    proxy_pass http://127.0.0.1:8791/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
}
