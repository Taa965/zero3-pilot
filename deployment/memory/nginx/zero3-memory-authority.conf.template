# Render __ZERO3_MEMORY_DOMAIN__ before installation.
# The Rust service stays loopback-only on 127.0.0.1:8790.

map $http_upgrade $zero3_memory_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __ZERO3_MEMORY_DOMAIN__;

    client_max_body_size 512k;

    location = /health {
        proxy_pass http://127.0.0.1:8790/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /ready {
        proxy_pass http://127.0.0.1:8790/ready;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /v1/ {
        proxy_pass http://127.0.0.1:8790;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $zero3_memory_connection_upgrade;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }
}

# After DNS resolves to this host and `nginx -t` succeeds, obtain TLS with the
# host's existing certificate-management convention (for example certbot).
# Do not expose 8790 publicly and do not add a second public listen socket.
