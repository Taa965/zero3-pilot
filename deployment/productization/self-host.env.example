# Zero3 Pilot generic self-host configuration
#
# Copy to /etc/zero3-pilot/zero3-pilot.env for the reference systemd layout.
# This file intentionally contains paths and non-secret settings only.
# Create the token files separately with restrictive permissions.

# Application listener. zero3-web binds loopback itself.
ZERO3_WEB_PORT=8787

# Durable H5 control-plane state.
ZERO3_CONTROL_PLANE_DATA_DIR=/var/lib/zero3-pilot/control-plane

# Remote Host / control API authentication.
# Both variables must be configured together or both omitted.
ZERO3_HOST_TOKEN_FILE=/etc/zero3-pilot/secrets/host.token
ZERO3_CONTROL_TOKEN_FILE=/etc/zero3-pilot/secrets/control.token
