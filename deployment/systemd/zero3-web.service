[Unit]
Description=Zero3 Pilot control/web server
After=network.target

[Service]
Type=simple
# Non-root by default — reuse an existing deploy user if the target host
# already has one; only fall back to creating `zero3-pilot` if it does not.
User=zero3-pilot
Group=zero3-pilot
WorkingDirectory=/opt/zero3-pilot/current
ExecStart=/opt/zero3-pilot/current/bin/zero3-web
Environment=ZERO3_WEB_PORT=8788
Restart=on-failure
RestartSec=2

# Minimal hardening; loosen only if a specific capability is proven needed.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zero3-pilot

[Install]
WantedBy=multi-user.target
