+/// Preserves only the bounded opaque D1 locator token when Codex's existing
+/// fit-to-window fallback is already going to replace the entire output.
+///
+/// Presence of a locator never decides whether fallback truncation happens;
+/// D2's extension performs real SpillStore sidecar verification before its own
+/// pruning. This helper only prevents the fallback replacement from erasing a
+/// recovery token that was already model-visible.
+fn retained_zero3_spill_locator(text: &str) -> Option<&str> {
+    let start = text.rfind(ZERO3_SPILL_LOCATOR_PREFIX)?;
+    let rest = &text[start..];
+    let end = rest
+        .find(|character: char| {
+            character.is_whitespace()
+                || matches!(character, ']' | ';' | ',' | ')' | '>' | '"' | '\'')
+        })
+        .unwrap_or(rest.len());
+    let locator = &rest[..end];
+    (locator.len() > ZERO3_SPILL_LOCATOR_PREFIX.len()).then_some(locator)
+}
