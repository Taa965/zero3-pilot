+#[cfg(test)]
+mod zero3_recovery_locator_tests {
+    use super::*;
+
+    #[test]
+    fn remote_fallback_retains_only_the_locator_token() {
+        let text = "preview zero3-spill://v1/1a-2b-3c; recover with read_spill";
+        assert_eq!(
+            retained_zero3_spill_locator(text),
+            Some("zero3-spill://v1/1a-2b-3c")
+        );
+    }
+
+    #[test]
+    fn remote_fallback_has_no_zero3_suffix_without_locator() {
+        assert_eq!(retained_zero3_spill_locator("ordinary output"), None);
+    }
+}
