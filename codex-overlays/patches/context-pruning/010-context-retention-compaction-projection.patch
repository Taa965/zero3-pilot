+/// Runs registered model-projection contributors against a private compaction
+/// history clone. Authoritative session history and envelope metadata are never
+/// mutated by this helper.
+pub(crate) async fn project_compaction_history(sess: &Session, history: &mut ContextManager) {
+    let contributors = sess.services.extensions.tool_lifecycle_contributors();
+    if contributors.is_empty() {
+        return;
+    }
+
+    let mut items = history.annotated_items().to_vec();
+    let mut changed = false;
+    for envelope in &mut items {
+        for contributor in contributors {
+            let input = codex_extension_api::CompactionHistoryItemInput {
+                thread_store: &sess.services.thread_extension_data,
+                turn_id: envelope.turn_id(),
+                item: &envelope.item,
+            };
+            match contributor.on_compaction_history_item(input).await {
+                Ok(Some(projected)) => {
+                    envelope.item = projected;
+                    changed = true;
+                }
+                Ok(None) => {}
+                Err(error) => tracing::warn!(
+                    %error,
+                    "compaction history projection contributor failed; keeping current item"
+                ),
+            }
+        }
+    }
+
+    if changed {
+        history.replace_annotated(items);
+    }
+}
