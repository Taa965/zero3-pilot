{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero3.local/schemas/zero3.memory.context-manifest.v1.schema.json",
  "title": "Zero3 Agent Context Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "task_id", "project_sequence", "task_sequence", "authority_items", "retrieval_items", "native_context_used", "native_context_stale_items", "generated_at"],
  "properties": {
    "schema": {"const": "zero3.memory.context-manifest.v1"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_id": {"type": ["string", "null"], "maxLength": 256},
    "project_sequence": {"type": "integer", "minimum": 0},
    "task_sequence": {"type": "integer", "minimum": 0},
    "authority_items": {"type": "array", "items": {"type": "string", "maxLength": 256}},
    "retrieval_items": {"type": "array", "items": {"type": "string", "maxLength": 256}},
    "native_context_used": {"type": "boolean"},
    "native_context_stale_items": {"type": "array", "items": {"type": "string", "maxLength": 256}},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
