{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zero3.pilot.development-session.v1",
  "title": "Zero3 Development Session V1",
  "type": "object",
  "required": ["contract", "groupId", "sessionId", "executionId", "waveId", "objective", "baselineSha", "integrationRef", "branch", "worktree", "ownedPaths", "readOnlyPaths", "forbiddenPaths", "dependencies", "requirements", "inputs", "acceptanceCriteria", "executorPolicy", "subagentPolicy", "deliveryPolicy"],
  "properties": {
    "contract": { "const": "zero3.pilot.development-session.v1" },
    "groupId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "waveId": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "baselineSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "integrationRef": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "worktree": { "type": "string", "minLength": 1 },
    "ownedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "readOnlyPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "forbiddenPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "requirements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "subagentPolicy": {
      "type": "object",
      "required": ["allowed", "maxConcurrency", "recursiveGroupCreation"],
      "properties": {
        "allowed": { "type": "boolean" },
        "maxConcurrency": { "type": "integer", "minimum": 1 },
        "recursiveGroupCreation": { "const": false }
      },
      "additionalProperties": false
    }
  }
}
